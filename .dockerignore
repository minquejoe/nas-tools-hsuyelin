# 版本控制（.git 保留在镜像内以支持容器内在线更新，REPO_URL 指定更新来源）
.github
.gitignore
*.md
!README.md

# 备份与临时文件
*.zip
*.tar.gz
/test.py
/setup.py
/build_sites.py
/build/
/cloudflarespeedtest/
nastools_test.py

# Python
__pycache__/
*.pyc
*.c
/venv/
/.venv/

# IDE与本地环境
/.idea/
/.vscode/
config/sites.json

# 运行时数据（通过volumes挂载，不能打进镜像：media体积巨大且config包含数据库与密钥，
# 不排除会导致构建上下文过大、构建缓慢甚至失败）
/media/
/config/

# 构建日志与本地docker配置
/.build.log
/.docker-tmp/

# 前端构建产物
/node_modules/
package-lock.json
package.json
