# 从本地源码构建 nas-tools 镜像（与 docker/Dockerfile 的区别：不再从GitHub拉取代码，直接使用构建上下文中的源码）
# 构建命令（在仓库根目录执行）：
#   docker build -f docker/Dockerfile.source -t nas-tools:source .
#
# 可选构建参数（国内网络环境加速）：
#   --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   --build-arg ALPINE_MIRROR=mirrors.ustc.edu.cn
#
# 注意：源码构建的镜像内不含 .git，容器的"在线更新/自动更新"功能不可用，
#       程序更新请重新执行 docker build 并重建容器，环境变量 NASTOOL_AUTO_UPDATE 请保持 false。

FROM python:3.10.11-alpine
ARG PIP_INDEX_URL=""
ARG ALPINE_MIRROR=""

ENV WORKDIR="/nas-tools"

WORKDIR ${WORKDIR}

# 先复制依赖清单并安装依赖（利用层缓存：仅源码变动时不会重新安装依赖）
COPY package_list.txt requirements.txt ./
RUN if [ -n "${ALPINE_MIRROR}" ]; then \
        sed -i "s/dl-cdn.alpinelinux.org/${ALPINE_MIRROR}/g" /etc/apk/repositories; \
    fi \
    && apk add --no-cache --virtual .build-deps \
        libffi-dev \
        gcc \
        musl-dev \
        libxml2-dev \
        libxslt-dev \
    && apk add --no-cache $(echo $(cat package_list.txt)) \
    && curl https://rclone.org/install.sh | bash \
    && if [ "$(uname -m)" = "x86_64" ]; then ARCH=amd64; elif [ "$(uname -m)" = "aarch64" ]; then ARCH=arm64; fi \
    && curl https://dl.min.io/client/mc/release/linux-${ARCH}/mc --create-dirs -o /usr/bin/mc \
    && chmod +x /usr/bin/mc \
    && pip install --upgrade pip setuptools wheel ${PIP_INDEX_URL:+ -i "${PIP_INDEX_URL}"} \
    && pip install cython ${PIP_INDEX_URL:+ -i "${PIP_INDEX_URL}"} \
    && pip install -r requirements.txt ${PIP_INDEX_URL:+ -i "${PIP_INDEX_URL}"} \
    && apk del --purge .build-deps \
    && rm -rf /tmp/* /root/.cache /var/cache/apk/*

ENV S6_SERVICES_GRACETIME=30000 \
    S6_KILL_GRACETIME=60000 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_SYNC_DISKS=1 \
    HOME="/nt" \
    TERM="xterm" \
    PATH=${PATH}:/usr/lib/chromium \
    LANG="C.UTF-8" \
    TZ="Asia/Shanghai" \
    NASTOOL_CONFIG="/config/config.yaml" \
    NASTOOL_AUTO_UPDATE=false \
    NASTOOL_CN_UPDATE=true \
    NASTOOL_VERSION=master \
    PS1="\u@\h:\w \$ " \
    REPO_URL="https://github.com/hsuyelin/nas-tools.git" \
    PYPI_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple" \
    ALPINE_MIRROR="mirrors.ustc.edu.cn" \
    PUID=0 \
    PGID=0 \
    UMASK=000 \
    PYTHONWARNINGS="ignore:semaphore_tracker:UserWarning"

RUN mkdir ${HOME} \
    && addgroup -S nt -g 911 \
    && adduser -S nt -G nt -h ${HOME} -s /bin/bash -u 911 \
    && python_ver=$(python3 -V | awk '{print $2}') \
    && [ -d "/usr/lib/python${python_ver%.*}/site-packages" ] || mkdir -p "/usr/lib/python${python_ver%.*}/site-packages" \
    && echo "${WORKDIR}/" > /usr/lib/python${python_ver%.*}/site-packages/nas-tools.pth \
    && echo 'fs.inotify.max_user_watches=5242880' >> /etc/sysctl.conf \
    && echo 'fs.inotify.max_user_instances=5242880' >> /etc/sysctl.conf \
    && echo "nt ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers \
    && git config --global pull.ff only \
    && git config --global --add safe.directory ${WORKDIR}

# 复制本地源码（含 third_party 子模块内容，克隆源码时请使用 --recurse-submodule）
COPY --chown=nt:nt . .

# 初始化依赖哈希文件，供容器启动时的依赖变更检测使用
RUN sha256sum requirements.txt > /tmp/requirements.txt.sha256sum \
    && sha256sum third_party.txt > /tmp/third_party.txt.sha256sum \
    && sha256sum package_list.txt > /tmp/package_list.txt.sha256sum

COPY --chmod=755 ./docker/rootfs /

EXPOSE 3000
VOLUME ["/config"]
ENTRYPOINT [ "/init" ]
